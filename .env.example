# Copy this file to .env and fill in your actual credentials
# DO NOT commit the .env file to version control

# Cakemail Personal Access Token (ck_pat_…), created with POST /users/self/pats.
# Use the emailapi:send scope for sending. Never put your account password here.
CAKEMAIL_API_KEY='ck_pat_your-personal-access-token'

# Optional: Enable debug mode (defaults to false)
# CAKEMAIL_DEBUG=false

# Test Environment (optional, read by tests/config/test-config.ts only)
# CAKEMAIL_TEST_USERNAME='test-email@example.com'
# CAKEMAIL_TEST_PASSWORD='test-password'
# CAKEMAIL_TEST_MODE=false
